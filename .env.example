# Required before starting the server. Never commit your real .env file.
PORT=3000
NODE_ENV=development
ADMIN_USERNAME=hendy-admin
ADMIN_PASSWORD=KaSHFpwBtU0Y9rErb8ssMYVDIFH8xT8r
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_HOURS=12

# Local defaults. On Render, mount a persistent disk and point both paths to it.
DATA_FILE=./data.json
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=500

# Comma-separated exact browser origins when hosting the UI separately.
# Example: CORS_ORIGINS=https://your-project.pages.dev,https://your-project.github.io
CORS_ORIGINS=
# Use "none" for cross-site Pages -> Render cookie auth (requires HTTPS), or "lax" for same-site.
COOKIE_SAME_SITE=lax
