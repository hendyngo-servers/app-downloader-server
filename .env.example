# Copy this file to .env for local development. Never commit real secrets.
PORT=3000
NODE_ENV=development
ADMIN_USERNAME=change-me
ADMIN_PASSWORD=replace-with-a-strong-password
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_HOURS=12

# Local development (default). Local file data is not durable on Render Free.
STORAGE_DRIVER=local
DATA_FILE=./data.json
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=500

# Optional durable storage: Cloudflare R2 (S3-compatible).
# Endpoint format: https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
# For R2 mode, set STORAGE_DRIVER=r2 and fill every R2_* variable below.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PREFIX=app-downloader-server

# Optional exact browser origins for separate frontend domains.
CORS_ORIGINS=
COOKIE_SAME_SITE=lax
